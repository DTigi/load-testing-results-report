                <stringProp name="script">// Импортируем утилиту для генерации случайных строк
import org.apache.commons.lang3.RandomStringUtils

// Генерация уникального логина и пароля
def user = RandomStringUtils.random(6, &quot;asdfghqwerty&quot;)
def pass = RandomStringUtils.random(6, &quot;asdfgh1234567890&quot;)

// Сохраняем переменные
vars.put(&quot;user&quot;, user)
vars.put(&quot;pass&quot;, pass)</stringProp>
