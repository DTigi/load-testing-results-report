              <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="JSR223 PreProcessor" enabled="true">
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="script">def boundary = &quot;WebKitFormBoundary9waW5r2CJg75B9gy&quot;
def matchNr = vars.get(&quot;flightIDs_matchNr&quot;) as int
def sb = new StringBuilder()

// Выбираем случайный индекс flightID
def randomIndex = 1 + (Math.random() * matchNr).intValue()
def randomFlightID = vars.get(&quot;flightIDs_&quot; + randomIndex)

// Добавляем все flightIDs (обязательное условие формы — как в HAR)
for (int i = 1; i &lt;= matchNr; i++) {
    def flightID = vars.get(&quot;flightIDs_&quot; + i)
    sb.append(&quot;--${boundary}\r\n&quot;)
    sb.append(&quot;Content-Disposition: form-data; name=\&quot;flightID\&quot;\r\n\r\n&quot;)
    sb.append(flightID + &quot;\r\n&quot;)

    // Если это выбранный — добавляем чекбокс (on)
    if (i == randomIndex) {
        sb.append(&quot;--${boundary}\r\n&quot;)
        sb.append(&quot;Content-Disposition: form-data; name=\&quot;${i}\&quot;\r\n\r\n&quot;)
        sb.append(&quot;on\r\n&quot;)
    }
}

// Симуляция клика по кнопке &quot;Remove Flights&quot;
sb.append(&quot;--${boundary}\r\n&quot;)
sb.append(&quot;Content-Disposition: form-data; name=\&quot;removeFlights.x\&quot;\r\n\r\n&quot;)
sb.append(&quot;48\r\n&quot;)

sb.append(&quot;--${boundary}\r\n&quot;)
sb.append(&quot;Content-Disposition: form-data; name=\&quot;removeFlights.y\&quot;\r\n\r\n&quot;)
sb.append(&quot;10\r\n&quot;)

// Добавляем .cgifields = i для всех индексов
for (int i = 1; i &lt;= matchNr; i++) {
    sb.append(&quot;--${boundary}\r\n&quot;)
    sb.append(&quot;Content-Disposition: form-data; name=\&quot;.cgifields\&quot;\r\n\r\n&quot;)
    sb.append(i + &quot;\r\n&quot;)
}

sb.append(&quot;--${boundary}--\r\n&quot;)

// Сохраняем тело запроса
vars.put(&quot;body&quot;, sb.toString())
</stringProp>
                <stringProp name="scriptLanguage">groovy</stringProp>
              </JSR223PreProcessor>
              <hashTree/>
              <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="JSR223 Assertion" enabled="true">
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="script">def before = vars.get(&quot;flightIDs_matchNr&quot;) as int
def matches = prev.getResponseDataAsString() =~ /name=&quot;flightID&quot;/
def after = matches.count

// Проверка: билетов стало на 1 меньше
if (after != before - 1) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(&quot;Удаление билета не произошло. До: ${before}, После: ${after}&quot;)
}
</stringProp>
                <stringProp name="scriptLanguage">groovy</stringProp>
              </JSR223Assertion>
