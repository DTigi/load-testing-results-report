              <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Generate Flight Data" enabled="true">
                <stringProp name="scriptLanguage">groovy</stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="script">import java.text.SimpleDateFormat
import java.util.Random
            
            // Список городов
            def cities = [&quot;Denver&quot;, &quot;Frankfurt&quot;, &quot;Los Angeles&quot;, &quot;London&quot;, &quot;Paris&quot;, &quot;Portland&quot;, &quot;San Francisco&quot;, &quot;Seattle&quot;, &quot;Sydney&quot;, &quot;Zurich&quot;]
            def random = new Random()
            
            // Выбор случайных городов (depart и arrive не должны совпадать)
            def departCity = cities[random.nextInt(cities.size())]
            def arriveCity
            do {
                arriveCity = cities[random.nextInt(cities.size())]
            } while (arriveCity == departCity)
            
            // Случайные даты (в пределах 2025 года)
            def sdf = new SimpleDateFormat(&quot;MM/dd/yyyy&quot;)
            def calendar = Calendar.getInstance()
            calendar.set(2025, Calendar.JANUARY, 1)
            def startDate = calendar.time
            calendar.add(Calendar.YEAR, 1)
            def endDate = calendar.time
            def departDate = new Date(startDate.time + random.nextLong(endDate.time - startDate.time))
            calendar.setTime(departDate)
            calendar.add(Calendar.DAY_OF_YEAR, 1) // Возврат на следующий день
            def returnDate = calendar.time
            
            // Случайное количество пассажиров (1-4)
            def numPassengers = random.nextInt(4) + 1
            
            // Случайные предпочтения по местам и типу
            def seatPrefs = [&quot;Aisle&quot;, &quot;Window&quot;, &quot;None&quot;]
            def seatTypes = [&quot;First&quot;, &quot;Business&quot;, &quot;Coach&quot;]
            def seatPref = seatPrefs[random.nextInt(seatPrefs.size())]
            def seatType = seatTypes[random.nextInt(seatTypes.size())]
            
            // Сохранение переменных в JMeter
            vars.put(&quot;departCity&quot;, departCity)
            vars.put(&quot;arriveCity&quot;, arriveCity)
            vars.put(&quot;departDate&quot;, sdf.format(departDate))
            vars.put(&quot;returnDate&quot;, sdf.format(returnDate))
            vars.put(&quot;numPassengers&quot;, numPassengers.toString())
            vars.put(&quot;seatPref&quot;, seatPref)
            vars.put(&quot;seatType&quot;, seatType)
            //vars.put(&quot;findFlightsX&quot;, random.nextInt(50).toString()) // Случайные координаты клика
            //vars.put(&quot;findFlightsY&quot;, random.nextInt(20).toString())
</stringProp>
              </JSR223PreProcessor>
